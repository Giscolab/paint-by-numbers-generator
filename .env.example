# Copy this file to .env and set your PUBLIC Supabase project values.
# Never put service_role, sb_secret_*, passwords or provider API tokens in VITE_* variables.
VITE_SUPABASE_PROJECT_ID=your-project-id
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=your-public-anon-or-publishable-key
